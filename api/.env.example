# Copy to api/.env and fill in. api/.env is ignored by git.
# The Supabase Project URL, with no path: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Browser origins allowed to call the API, as a JSON list. Each one is exactly what the
# browser sends: scheme, host and port, lowercase, no trailing slash.
CORS_ORIGINS=["http://localhost:5173"]
# Owner connection for migrations (uv run alembic upgrade head), through the Supabase session pooler:
# postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
MIGRATION_DATABASE_URL=
# The API's own role, studyflow_api: no privileges of its own and no BYPASSRLS. Used by the API from S09; empty means no database (endpoints that need it answer 503).
# postgresql://studyflow_api.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=
# The worker only, never the API: the schema owner (postgres), through the Supabase session pooler.
# The worker bypasses RLS as the owner for app.jobs and runs each user's work as that user.
# postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
WORKER_DATABASE_URL=
# The worker only: the project's secret key (sb_secret_...), for the private materials bucket.
SUPABASE_SECRET_KEY=
# The worker and the S11 eval only: the Anthropic API key. Empty means course analysis is not configured.
ANTHROPIC_API_KEY=
# The models for course analysis and for light tasks. Sonnet 5.5 for analysis was chosen by the
# S11 eval (api/eval/README.md): close to Opus in quality at about 40% of the cost.
AI_MODEL_ANALYSIS=claude-sonnet-5-5
AI_MODEL_LIGHT=claude-haiku-5-5
# Claude call limits, all optional (the values below are the defaults). AI_TIMEOUT_SECONDS applies to
# each read from the network; AI_TIMEOUT_SECONDS x (AI_MAX_RETRIES + 1) must stay below JOB_LOCK_TIMEOUT_SECONDS.
# AI_TIMEOUT_SECONDS=180
# AI_MAX_RETRIES=2
# Plan generations per user per local day, and the timezone that decides where the day starts.
# AI_DAILY_GENERATION_LIMIT=3
# AI_QUOTA_TIMEZONE=Asia/Jerusalem
